FROM docker.io/library/gcc:16.2.0-trixie@sha256:b98be39c2378222af9dcab6a5b1707d74b47d7c413c8569d5429a4cbfefbe981

# GCC is already built in the base image. Only install build utilities here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    make autoconf automake libtool pkg-config texinfo gettext \
    python3 curl ca-certificates xz-utils zstd patch file gnutls-bin \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
