;;; observer.el --- Observe configured lsp-mode under replay -*- lexical-binding: t; -*-
(require 'json)
(defvar load-control nil)
(defvar load-sequence 0)
(defvar load-diagnostics 0)
(defvar load-started nil)
(defvar load-done nil)
(defvar load-gc-start 0)
(defvar load-gcs-start 0)
(defvar load-gc-last 0)
(defvar load-pauses nil)
(defvar load-error nil)
(defvar load-buffer nil)
(defun load-send (data)
  (process-send-string load-control (concat (json-serialize data) "\n")))
(defun load-count-diagnostics (&rest _)
  (setq load-diagnostics (1+ load-diagnostics)))
(defun load-record-gc ()
  (when (and load-started (not load-done))
    (push (- gc-elapsed load-gc-last) load-pauses)
    (setq load-gc-last gc-elapsed)))
(defun load-retained ()
  (let ((table (lsp-diagnostics)) (count 0))
    (maphash (lambda (_ entries) (setq count (+ count (length entries)))) table)
    `((files . ,(hash-table-count table)) (diagnostics . ,count))))
(defun load-ready (_workspace _params)
  (run-at-time
   0 nil (lambda ()
           (with-current-buffer load-buffer
             (when (fboundp 'evil-insert-state) (evil-insert-state))
             (garbage-collect)
             (load-send `((kind . "ready") (retained . ,(load-retained))
                          (threshold . ,gc-cons-threshold) (percentage . ,gc-cons-percentage)
                          (lsp_use_plists . ,(if lsp-use-plists t :false))
                          (booster . ,(if (executable-find "emacs-lsp-booster") t :false))))))))
(defun load-finished (_workspace _params)
  (setq load-done `((seconds . ,(- (float-time) load-started))
                    (messages . ,load-diagnostics)
                    (gc_seconds . ,(- gc-elapsed load-gc-start))
                    (collections . ,(- gcs-done load-gcs-start))
                    (gc_pauses . ,(vconcat (reverse load-pauses)))
                    (retained . ,(load-retained)))))
(defun load-start ()
  (interactive)
  (unless (and (= gc-cons-threshold 16000000) (= gc-cons-percentage 0.1))
    (error "Unexpected runtime GC settings: %S %S" gc-cons-threshold gc-cons-percentage))
  (setq load-diagnostics 0 load-pauses nil load-done nil
        load-gc-start gc-elapsed load-gc-last gc-elapsed load-gcs-start gcs-done
        load-started (float-time))
  (lsp-notify "load/start" (list :mode (getenv "LSP_LOAD_MODE"))))
(defun load-report ()
  (redisplay t)
  (load-send `((kind . "checkpoint") (sequence . ,load-sequence)
               (size . ,(with-current-buffer load-buffer (buffer-size)))
               (done . ,(or load-done :null)) (error . ,(or load-error :null)))))
(defun load-checkpoint ()
  (interactive)
  (setq load-sequence (1+ load-sequence))
  (run-at-time 0 nil #'load-report))
(defun load-exit ()
  (interactive)
  (load-send '((kind . "exit")))
  (kill-emacs 0))
(defun load-setup ()
  (condition-case err
      (progn
        (when (fboundp 'elpaca-wait) (elpaca-wait))
        (when init-file-had-error (error "User init failed"))
        (require 'lsp-mode)
        (setq load-control (make-network-process :name "load-control" :family 'local
                                                :service (getenv "WORKLOAD_SOCKET")
                                                :coding 'utf-8-unix :noquery t))
        (advice-add 'lsp--on-diagnostics :after #'load-count-diagnostics)
        (add-hook 'post-gc-hook #'load-record-gc)
        (setq lsp-auto-guess-root t lsp-enabled-clients '(pgo-load-test))
        (lsp-register-client
         (make-lsp-client :new-connection (lsp-stdio-connection
                                          (list "python3" (getenv "LSP_LOAD_SERVER")))
                          :major-modes '(text-mode) :language-id "plaintext"
                          :server-id 'pgo-load-test :priority 1000
                          :notification-handlers (ht ("load/ready" #'load-ready)
                                                     ("load/done" #'load-finished))))
        (find-file (expand-file-name "file-0.txt" (getenv "LSP_LOAD_PROJECT")))
        (setq load-buffer (current-buffer))
        (text-mode)
        (local-set-key (kbd "<f6>") #'load-start)
        (global-set-key (kbd "<f12>") #'load-checkpoint)
        (global-set-key (kbd "<f4>") #'load-exit)
        (lsp))
    (error (setq load-error (error-message-string err))
           (when load-control (load-send `((kind . "ready") (error . ,load-error)))))))
(add-hook 'window-setup-hook (lambda () (run-at-time 0 nil #'load-setup)) t)
