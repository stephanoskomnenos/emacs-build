diff --git a/benchmarks/files.el b/benchmarks/files.el
index 3441ad9..33d739a 100644
--- a/benchmarks/files.el
+++ b/benchmarks/files.el
@@ -6,6 +6,13 @@
     (lambda (file)
       (let ((start (float-time)))
         (find-file file)
+        (when exercise
+          ;; A neutral editing position lets scans encounter both sides of the gap.
+          (save-excursion
+            (goto-char (/ (+ (point-min) (point-max)) 2))
+            (insert " ")
+            (delete-char -1))
+          (set-buffer-modified-p nil))
         (redisplay t)
         (when font-lock-mode
           (font-lock-ensure (window-start) (window-end nil t)))
diff --git a/benchmarks/interactive/training.el b/benchmarks/interactive/training.el
