;;; training.el --- Generic training, independent of validation inputs -*- lexical-binding: t; -*-
(require 'json)
(require 'cl-lib)
(dolist (library '(project xref compile recentf savehist icomplete)) (require library))
(load (expand-file-name "../files.el" (file-name-directory load-file-name)) nil t)
(setq inhibit-startup-screen t make-backup-files nil auto-save-default nil
      enable-local-variables nil ring-bell-function #'ignore)
(icomplete-mode 1)
(defvar train-sequence 0)
(defvar train-value 0)
(defvar train-lines 0)
(defvar train-remainder "")
(defvar train-finished t)
(defvar train-documents (make-hash-table :test 'equal))
(defvar train-filter-calls 0)
(defvar train-error nil)
(defvar train-compilation-status "")
(add-hook 'compilation-finish-functions
          (lambda (_buffer status) (setq train-compilation-status (string-trim status))))
(defvar train-cancel-notify nil)
(defun train-arm-cancel () (interactive) (setq train-cancel-notify t))
(add-hook 'minibuffer-exit-hook
          (lambda ()
            (when train-cancel-notify
              (setq train-cancel-notify nil)
              (run-at-time 0 nil (lambda () (train-send '((kind . "cancelled"))))))))
(defun train-send (message)
  (send-string-to-terminal
   (concat "\e]777;emacs-workload;" (json-serialize message) "\a")))
(defun train-report ()
  (if (or (not train-finished) compilation-in-progress)
      (run-at-time 0.001 nil #'train-report)
    (redisplay t)
    (train-send `((kind . "checkpoint") (sequence . ,train-sequence)
                  (minibuffer_depth . ,(minibuffer-depth))
                  (mode . ,(symbol-name major-mode)) (buffer . ,(buffer-name))
                  (text . ,(buffer-substring-no-properties (point-min) (min (point-max) (+ (point-min) 4096))))
                  (file . ,(or buffer-file-name "")) (size . ,(buffer-size)) (point . ,(point))
                  (compilation_status . ,train-compilation-status)
                  (compilation_output . ,(if (get-buffer "*compilation*")
                                             (with-current-buffer "*compilation*"
                                               (buffer-substring-no-properties (point-min) (min (point-max) (+ (point-min) 4096))))
                                           ""))
                  (value . ,train-value) (frames . ,train-lines)
                  (evil_state . ,(when (boundp 'evil-state) (symbol-name evil-state)))
                  (retained . ,(hash-table-count train-documents)) (filter_calls . ,train-filter-calls)
                  (error . ,(or train-error :null))))))
(defun train-checkpoint ()
  (interactive) (cl-incf train-sequence) (run-at-time 0 nil #'train-report))
(defun train-exit ()
  (interactive) (train-send '((kind . "exit"))) (kill-emacs 0))
(defun train-files ()
  (interactive)
  (require 'org)
  (require 'cc-mode)
  (let ((files (directory-files (getenv "TRAIN_CORPUS") t "\\.\\(c\\|el\\|org\\|txt\\)\\'")))
    (unless files (error "Empty training corpus"))
    (dotimes (_ 2) (benchmark-files files t))
    (setq train-value (length files))))
(defun train-filter (_process text)
  (cl-incf train-filter-calls)
  (setq train-remainder (concat train-remainder text))
  (while (string-match "\n" train-remainder)
    (let* ((end (match-beginning 0)) (line (substring train-remainder 0 end)))
      (setq train-remainder (substring train-remainder (1+ end)))
      (condition-case error
          (with-temp-buffer
            (insert line)
            (goto-char (point-min))
            (let* ((message (json-parse-buffer)) (params (gethash "params" message)))
              (cl-incf train-value (gethash "ordinal" params))
              (cl-incf train-lines)
              (puthash (gethash "uri" params) (gethash "diagnostics" params) train-documents)
              (json-serialize message)))
        (error (setq train-error (error-message-string error)))))))
(defun train-process ()
  (interactive)
  (setq train-finished nil train-value 0 train-lines 0 train-remainder "" train-error nil train-filter-calls 0)
  (clrhash train-documents)
  (make-process :name "training-rpc" :connection-type 'pipe :coding 'utf-8-unix :noquery t
                :filter #'train-filter
                :sentinel (lambda (process _event)
                            (setq train-finished t)
                            (unless (string-empty-p train-remainder)
                              (setq train-error "Truncated JSON message"))
                            (unless (= (process-exit-status process) 0)
                              (setq train-error "Training process failed")))
                :command (list "python3" (getenv "TRAIN_PRODUCER") "rpc"
                               (or (getenv "TRAIN_PROCESS_VARIANT") "fragmented"))))
(defun train-org ()
  (interactive)
  (require 'org)
  (find-file (expand-file-name "org-news.org" (getenv "TRAIN_CORPUS")))
  (when (equal (getenv "TRAIN_BALANCED_GAP") "1")
    (goto-char (/ (+ (point-min) (point-max)) 2))
    (insert " ")
    (delete-char -1)
    (set-buffer-modified-p nil))
  (goto-char (point-min)))
(dolist (entry '(("<f3>" . train-arm-cancel) ("<f4>" . train-exit) ("<f6>" . train-files)
                 ("<f8>" . train-process) ("<f9>" . train-org)
                 ("<f12>" . train-checkpoint)))
  (keymap-global-set (car entry) (cdr entry)))
(dolist (directory (reverse (append (json-parse-string
                                     (with-temp-buffer
                                       (insert-file-contents (getenv "TRAIN_PACKAGES"))
                                       (buffer-string))) nil)))
  (add-to-list 'load-path directory))
(when (equal (getenv "TRAIN_EVIL") "1")
  (require 'evil)
  (when (fboundp 'undo-redo)
    (setq evil-undo-system 'undo-redo)
    (evil-set-undo-system evil-undo-system))
  (evil-mode 1)
  (dolist (map (list evil-normal-state-map evil-insert-state-map
                     evil-visual-state-map evil-motion-state-map))
    (define-key map (kbd "<f12>") #'train-checkpoint)))
(autoload 'magit-status "magit" nil t)
(add-hook 'window-setup-hook
          (lambda ()
            (train-send '((kind . "ready")))) t)
