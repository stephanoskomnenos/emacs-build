;;; observer.el --- PTY workload acknowledgements -*- lexical-binding: t; -*-
(require 'json)
(require 'cl-lib)
(when (require 'evil nil t) (evil-mode 1))
(setq inhibit-startup-screen t make-backup-files nil auto-save-default nil
      ring-bell-function #'ignore enable-local-variables nil)
(defvar workload-spec (json-parse-string (with-temp-buffer
                                         (insert-file-contents (getenv "WORKLOAD_SPEC"))
                                         (buffer-string)) :object-type 'alist))
(defvar workload-sequence 0)
(defvar workload-command-count 0)
(defvar workload-value 0)
(defvar workload-process nil)
(defvar workload-process-error nil)
(defvar workload-process-finished t)
(defvar workload-frames 0)
(defvar workload-remainder "")
(defun workload-send (data)
  (send-string-to-terminal
   (concat "\e]777;emacs-workload;" (json-serialize data) "\a")))
(defun workload-report ()
  (if (not workload-process-finished)
      (run-at-time 0.001 nil #'workload-report)
    (redisplay t)
    (workload-send `((kind . "checkpoint") (sequence . ,workload-sequence)
                    (gcs_done . ,gcs-done) (gc_elapsed . ,gc-elapsed)
                    (commands . ,workload-command-count) (buffer . ,(buffer-name))
                    (mode . ,(symbol-name major-mode)) (point . ,(point))
                    (text . ,(buffer-substring-no-properties (point-min) (min (point-max) (+ (point-min) 4096))))
                    (evil_state . ,(when (boundp 'evil-state) (symbol-name evil-state)))
                    (size . ,(buffer-size)) (value . ,workload-value)
                    (frames . ,workload-frames) (error . ,(or workload-process-error :null))))))
(defun workload-checkpoint ()
  (interactive)
  (cl-incf workload-sequence)
  (run-at-time 0 nil #'workload-report))
(defun workload-exit ()
  (interactive)
  (workload-send '((kind . "exit")))
  (kill-emacs 0))
(defun workload-regexp ()
  (interactive)
  (setq workload-value 0)
  (with-temp-buffer
    (insert-file-contents (getenv "WORKLOAD_TEXT"))
    (dotimes (iteration (alist-get 'regexp_repeats workload-spec))
      ;; Same text and 60 scans: half with the gap before the text, half after.
      (when (or (= iteration 0)
                (= iteration (/ (alist-get 'regexp_repeats workload-spec) 2)))
        (goto-char (if (= iteration 0) (point-min) (point-max)))
        (insert " ")
        (delete-char -1))
      (goto-char (point-min))
      (while (re-search-forward "item-\\([0-9]+\\).*value=\\([0-9]+\\)" nil t)
        (cl-incf workload-value (string-to-number (match-string 2)))))))
(defun workload-json ()
  (interactive)
  (setq workload-value 0)
  (let ((data (with-temp-buffer (insert-file-contents (getenv "WORKLOAD_JSON")) (buffer-string))))
    (dotimes (_ (alist-get 'json_repeats workload-spec))
      (let* ((object (json-parse-string data)) (rows (gethash "items" object)))
        (mapc (lambda (row) (cl-incf workload-value (gethash "value" row))) rows)
        (json-serialize object)))))
(defun workload-gc ()
  (interactive)
  (setq workload-value 0)
  (let ((gc-cons-threshold 400000) (gc-cons-percentage 0.1))
    (dotimes (_ (alist-get 'gc_repeats workload-spec))
      (let ((items (cl-loop for i below (alist-get 'gc_items workload-spec)
                            collect (list i (number-to-string i) (make-vector 8 i)))))
        (cl-incf workload-value (length items))))
    (garbage-collect)))
(defun workload-process-filter (_process text)
  (setq workload-remainder (concat workload-remainder text))
  (while (string-match "\n" workload-remainder)
    (let* ((end (match-beginning 0)) (line (substring workload-remainder 0 end)))
      (setq workload-remainder (substring workload-remainder (1+ end)))
      (condition-case error
          (let ((message (json-parse-string line)))
            (cl-incf workload-value (gethash "value" message))
            (cl-incf workload-frames))
        (error (setq workload-process-error (error-message-string error)))))))
(defun workload-process-start ()
  (interactive)
  (setq workload-value 0 workload-frames 0 workload-remainder "" workload-process-error nil workload-process-finished nil)
  (setq workload-process
        (make-process :name "workload-producer" :connection-type 'pipe :noquery t
                      :coding 'utf-8-unix :filter #'workload-process-filter
                      :sentinel (lambda (process _event)
                                  (setq workload-process-finished t)
                                  (unless (= (process-exit-status process) 0)
                                    (setq workload-process-error "Subprocess failed")))
                      :command (list "python3" (getenv "WORKLOAD_PRODUCER")
                                     (number-to-string (alist-get 'process_frames workload-spec))
                                     (number-to-string (alist-get 'process_chunk workload-spec))))))
(dolist (entry '(("<f4>" . workload-exit) ("<f6>" . workload-regexp)
                 ("<f7>" . workload-json) ("<f8>" . workload-process-start)
                 ("<f9>" . workload-gc) ("<f12>" . workload-checkpoint)))
  (keymap-global-set (car entry) (cdr entry)))
(add-hook 'post-command-hook (lambda () (cl-incf workload-command-count)))
(when (getenv "WORKLOAD_PACKAGES")
  (dolist (directory (reverse (append (json-parse-string
                                      (with-temp-buffer
                                        (insert-file-contents (getenv "WORKLOAD_PACKAGES"))
                                        (buffer-string))) nil)))
    (add-to-list 'load-path directory))
  (autoload 'magit-status "magit" nil t))
(icomplete-mode 1)
(add-hook 'window-setup-hook
          (lambda ()
            (workload-send '((kind . "ready")))) t)
